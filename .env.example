# Shared local Postgres instance (nero-agent-postgres on 127.0.0.1:5433).
# Create an isolated database/role named jnbjt — do not reuse nero_agent tables.
DATABASE_URL=postgresql://jnbjt:CHANGE_ME@127.0.0.1:5433/jnbjt
TEST_DATABASE_URL=postgresql://jnbjt:CHANGE_ME@127.0.0.1:5433/jnbjt_test
DATABASE_POOL_MAX=3
API_HOST=127.0.0.1
API_PORT=3100
SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
CSRF_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
